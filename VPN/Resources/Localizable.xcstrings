    "Couldn't determine your location. Move somewhere with a better signal and try again." : {
      "comment" : "Text displayed in a warning banner at the top of the screen when the speed test couldn't determine the user's location.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke bestemme din placering. Flyt et sted med bedre signal, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort konnte nicht bestimmt werden. Wechsle an einen Ort mit besserem Empfang und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't determine your location. Move somewhere with a better signal and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo determinar tu ubicación. Muévete a un lugar con mejor señal e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de déterminer votre position. Déplacez-vous vers un endroit mieux couvert et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
