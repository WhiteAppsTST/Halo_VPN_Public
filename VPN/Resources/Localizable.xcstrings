          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine echte IP ist für externe Dienste sichtbar. Neu verbinden oder Kill Switch aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your real IP address is visible to external services. Reconnect or enable Kill Switch in settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
