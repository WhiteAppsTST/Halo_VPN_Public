    "Location access is denied. Allow it in Settings → Halo Hub → Location — the free speed test engine needs it to pick a measurement server." : {
      "comment" : "Text displayed when location access is denied.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til placering er afvist. Tillad den i Indstillinger → Halo Hub → Placering — den gratis hastighedstest bruger den til at vælge en måleserver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standortzugriff ist verweigert. Erlaube ihn in Einstellungen → Halo Hub → Standort — der kostenlose Speedtest wählt damit einen Messserver aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is denied. Allow it in Settings → Halo Hub → Location — the free speed test engine needs it to pick a measurement server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está denegado. Actívalo en Ajustes → Halo Hub → Ubicación: la prueba de velocidad gratuita la necesita para elegir un servidor de medición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à la localisation est refusé. Autorisez-le dans Réglages → Halo Hub → Position — le test de débit gratuit s'en sert pour choisir un serveur de mesure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso alla posizione è negato. Consentilo in Impostazioni → Halo Hub → Posizione: il test di velocità gratuito la usa per scegliere un server di misurazione."
          }
        }
      }
    },
    "Location is unavailable. The free speed test engine needs it to select a server — allow location access and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placering er utilgængelig. Den gratis hastighedstest kræver den for at vælge en server — giv adgang til placering, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standort nicht verfügbar. Der kostenlose Speedtest benötigt ihn zur Serverauswahl – erlaube den Standortzugriff und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is unavailable. The free speed test engine needs it to select a server — allow location access and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación no está disponible. El motor gratuito de la prueba de velocidad la necesita para elegir un servidor: permite el acceso e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localisation indisponible. Le moteur gratuit du test de débit en a besoin pour choisir un serveur — autorisez l'accès et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posizione non disponibile. Il motore gratuito del test di velocità la richiede per scegliere un server: consenti l'accesso e riprova."
          }
        }
      }
    },
    "Location Services are turned off. Enable them in Settings → Privacy & Security → Location Services — the free speed test engine needs your location to pick a measurement server." : {
      "comment" : "Text displayed when location services are disabled.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placeringstjenester er slået fra. Slå dem til i Indstillinger → Anonymitet og sikkerhed → Placeringstjenester — den gratis hastighedstest bruger din placering til at vælge en måleserver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ortungsdienste sind deaktiviert. Aktiviere sie in Einstellungen → Datenschutz & Sicherheit → Ortungsdienste — der kostenlose Speedtest wählt damit einen Messserver aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location Services are turned off. Enable them in Settings → Privacy & Security → Location Services — the free speed test engine needs your location to pick a measurement server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Localización está desactivada. Actívala en Ajustes → Privacidad y seguridad → Localización: la prueba de velocidad gratuita necesita tu ubicación para elegir un servidor de medición."
