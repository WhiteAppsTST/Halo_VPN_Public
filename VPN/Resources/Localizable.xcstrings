    "Your DNS queries are visible to your ISP. Switch to a server with DNS leak protection enabled." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine DNS-forespørgsler er synlige for din ISP. Skift til en server med DNS-lækagebeskyttelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine DNS-Anfragen sind für den Provider sichtbar. Wechsle zu einem Server mit DNS-Leak-Schutz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your DNS queries are visible to your ISP. Switch to a server with DNS leak protection enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus consultas DNS son visibles para tu ISP. Cambia a un servidor con protección de fugas DNS."
