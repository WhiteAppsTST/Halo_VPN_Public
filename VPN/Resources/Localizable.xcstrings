        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue query DNS sono visibili al provider. Passa a un server con protezione dalle fughe DNS."
          }
        }
      }
    },
    "Your real IP address is visible to external services. Reconnect or enable Kill Switch in settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
