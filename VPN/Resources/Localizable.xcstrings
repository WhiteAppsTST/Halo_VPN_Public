    "Powerful encryption keeps your browsing\nprotected on every network, even public Wi-Fi." : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stærk kryptering beskytter din browsing\npå ethvert netværk, også offentligt Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starke Verschlüsselung schützt dich\nin jedem Netzwerk, auch in öffentlichem WLAN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powerful encryption keeps your browsing\nprotected on every network, even public Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cifrado robusto protege tu navegación\nen cualquier red, incluso Wi-Fi público."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chiffrement puissant protège votre navigation\nsur tout réseau, même Wi-Fi public."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una crittografia potente protegge la tua navigazione\nsu ogni rete, anche Wi-Fi pubblici."
          }
        }
      }
    },
    "Precise Location is off. Turn it on in Settings → Halo Hub → Location — the speed test can't pick a server from an approximate position." : {
      "comment" : "Text displayed when precise location is disabled.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Præcis placering er slået fra. Slå den til i Indstillinger → Halo Hub → Placering — hastighedstesten kan ikke vælge en server ud fra en omtrentlig position."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genauer Standort ist aus. Aktiviere ihn in Einstellungen → Halo Hub → Standort — mit einer ungefähren Position kann der Speedtest keinen Server wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precise Location is off. Turn it on in Settings → Halo Hub → Location — the speed test can't pick a server from an approximate position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ubicación precisa está desactivada. Actívala en Ajustes → Halo Hub → Ubicación: con una posición aproximada la prueba de velocidad no puede elegir servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position précise est désactivée. Activez-la dans Réglages → Halo Hub → Position — le test de débit ne peut pas choisir de serveur à partir d'une position approximative."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La posizione precisa è disattivata. Attivala in Impostazioni → Halo Hub → Posizione: con una posizione approssimativa il test non può scegliere un server."
